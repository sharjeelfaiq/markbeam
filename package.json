{
  "name": "markbeam",
  "version": "0.1.0",
  "description": "Markbeam is an online Markdown editor with live preview, Mermaid diagrams and PDF export.",
  "main": "index.js",
  "scripts": {
    "test": "node tests/run.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve-dist": "http-server dist -p 5001 -c-1",
    "build-and-serve": "npm run build && npm run serve-dist",
    "test:serve": "vite --port 5173 --strictPort"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharjeelfaiq/markbeam.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "preview",
    "mermaid",
    "pdf"
  ],
  "author": "Sharjeel Faiq",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sharjeelfaiq/markbeam/issues"
  },
  "homepage": "https://github.com/sharjeelfaiq/markbeam#readme",
  "devDependencies": {
    "http-server": "^14.1.1",
    "puppeteer-core": "^23.11.1",
    "vite": "^6.4.2"
  },
  "dependencies": {
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "dompurify": "^3.4.0",
    "html2canvas-pro": "^2.4.0",
    "jspdf": "^4.2.1",
    "katex": "0.16.47",
    "marked": "^15.0.7",
    "marked-footnote": "1.4.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.52.2",
    "node-emoji": "^2.2.0"
  }
}
