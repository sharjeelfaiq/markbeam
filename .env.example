# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must never hold a
# real value.
#
# Used only by the live checks — `tests/live/github.mjs` (T52) and `tests/live/gitlab.mjs`
# (T63), which run the sync clients against the real APIs. Nothing in the app reads these: the app takes its token from the user at
# runtime and keeps it in memory unless they ask otherwise (see `src/remoteAuth.js`).

# A fine-grained personal access token, scoped to **Contents: read and write** on **one**
# scratch repository and nothing else. Not a classic token, and not one with account-wide
# scope: this script creates, updates and deletes a file, and that is the whole permission it
# should ever have.
MARKBEAM_GH_TOKEN=github_pat_replace_me

# The scratch repository it writes to, as owner/repo. Use one you do not mind a test file
# appearing in for a few seconds — the script deletes what it creates, but a failed run in the
# middle can leave a `markbeam-live-*.md` behind.
MARKBEAM_GH_REPO=you/markbeam-scratch

# ---- GitLab (T63) ----
#
# **Not the same containment as the GitHub token above.** GitHub's fine-grained token is scoped
# to one repository; GitLab's *personal* access token is account-wide and can reach every
# project you have. Prefer a **project access token** (project → Settings → Access tokens, role
# Developer, scope `api`) if your plan offers them, and give whichever you use a short expiry —
# the script needs it for about ten seconds.
#
# `api` rather than `write_repository`: the Repository Files API this client uses is not covered
# by `write_repository`, which is git-over-HTTP only.
MARKBEAM_GL_TOKEN=glpat_replace_me

# The scratch project, as group/project. Nesting is allowed (group/sub/project).
MARKBEAM_GL_PROJECT=you/markbeam-scratch
